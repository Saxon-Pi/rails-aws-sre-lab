<h1>Edit Task</h1>

<% if @task.errors.any? %>
  <div>
    <h2>入力内容にエラーがあります</h2>

    <ul>
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= button_to "Delete",
    "/tasks/#{@task.id}",
    method: :delete
%>

<%= form_with model: @task, url: "/tasks/#{@task.id}", method: :patch do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.text_field :status %>
  </div>

  <div>
    <%= form.submit "Update Task" %>
  </div>
<% end %>
